# ==========================================
# Aegis Configuration Template
# ==========================================
# Copy this file to .env and adjust as necessary.
# Never commit your actual .env file to version control.

# --- Optional Cloud LLM Credentials ---
# Leave empty to utilize the zero-cost Offline Intelligent Simulation Engine (aegis-engine-v1)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Server & Runtime Configuration ---
PORT=8000
USE_POSTGRES=false

# --- Database & Cache Configuration ---
POSTGRES_DB=aegis_db
POSTGRES_USER=aegis
POSTGRES_PASSWORD=aegis_secret
DATABASE_URL=postgresql://aegis:aegis_secret@localhost:5432/aegis_db
REDIS_URL=redis://localhost:6379/0
