# ==========================================
# Aegis Configuration Template
# ==========================================
# Copy this file to .env and adjust as necessary.
# Never commit your actual .env file to version control.

# --- LLM Provider Configuration ---
# Required: provider must be 'anthropic' or 'openai'
AEGIS_PROVIDER=anthropic
# Haiku 5.5 is ~20x cheaper than Sonnet 5.5; see aegis/config/pricing.yaml.
AEGIS_MODEL=claude-haiku-5-5
AEGIS_JUDGE_MODEL=claude-haiku-5-5

# --- Provider API Keys ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Runtime & Limits Configuration ---
AEGIS_AGENT_STEP_LIMIT=8
AEGIS_TOOL_OUTPUT_LIMIT=8000
AEGIS_SANDBOX_TIMEOUT=20.0
AEGIS_DATASET_MAX_BYTES=20971520
AEGIS_DATASET_MAX_ROWS=200000
AEGIS_DATASET_MAX_COLS=100
AEGIS_EMBEDDING_MODEL=all-MiniLM-L6-v2
AEGIS_EMBEDDING_DIM=384
AEGIS_LLM_MAX_OUTPUT_TOKENS=4096
AEGIS_LLM_MAX_RETRIES=3
AEGIS_LLM_TIMEOUT_S=60.0
AEGIS_PRICING_FILE=aegis/config/pricing.yaml
AEGIS_STRUCTURED_MODE=native

# --- Server & Database Configuration ---
PORT=8000
POSTGRES_USER=aegis_user
POSTGRES_PASSWORD=replace_with_secure_password
POSTGRES_DB=aegis_db
DATABASE_URL=postgresql://aegis_user:replace_with_secure_password@localhost:5432/aegis_db
REDIS_URL=redis://localhost:6379/0

# --- Queue & Worker Limits ---
AEGIS_TASK_TIMEOUT_S=300
AEGIS_MAX_CONCURRENT_TASKS=5
AEGIS_SANDBOX_IMAGE=aegis-sandbox:latest

# --- Sandbox task data (set by docker-compose.yml for the worker; leave unset locally) ---
# When the worker runs in a container, task datasets must live on a named volume so each
# sandbox can mount its own task's subpath. Both are set together or not at all.
# AEGIS_TASK_DATA_DIR=/var/lib/aegis/tasks
# AEGIS_SANDBOX_TASK_VOLUME=aegis_taskdata
